# ==========================================
# CampusShare / EduCircle Backend Configuration
# ==========================================
PORT=5000
JWT_SECRET=campushare_jwt_secret_key_2026_super_secure

# SMTP Real-Time Email Configuration
# To send real emails to students' Gmail inboxes:
# 1. Use your Gmail address as EMAIL_USER
# 2. Generate a 16-letter App Password from https://myaccount.google.com/apppasswords
# 3. Paste the 16-letter App Password below (without spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
